# ───────────────────────────────────────────────────────────────
#  OG System - environment variables
#  Copy this file to ".env" (npm run setup does it for you) and edit.
#  NEVER commit the real .env file.
# ───────────────────────────────────────────────────────────────

# Database (SQLite). Relative paths are resolved from the /prisma folder.
DATABASE_URL="file:./dev.db"

# API server
PORT=4000
# NODE_ENV=production   (npm start sets this automatically)
# Browser origin(s) allowed to call the API, comma separated.
# In development the Vite dev server runs on 5173.
CLIENT_ORIGIN=http://localhost:5173

# Secret used to hash session tokens. MUST be long & random in production.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_DAYS=14
# Set to true when the site is served over HTTPS (production).
COOKIE_SECURE=false

# File uploads (stored OUTSIDE the source folders, served only via authorised API)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Display currency for money values (ISO 4217 code)
APP_CURRENCY=USD

# ── Seed credentials (development only) ─────────────────────────
# Quote passwords that contain # (an unquoted # starts a comment).
# Used by `npm run seed` and `npm run seed:admin`.
SEED_ADMIN_NAME="Famolya Admin"
SEED_ADMIN_EMAIL=admin@og-system.local
SEED_ADMIN_PASSWORD="Admin#12345"
# Password given to the demo TEAM / CLIENT accounts created by `npm run seed`.
SEED_DEMO_PASSWORD="Demo#12345"

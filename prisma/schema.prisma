// OG System - Prisma schema (SQLite)
// After editing this file run:  npx prisma migrate dev --name <change>

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum ClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum Role {
  ADMIN
  TEAM
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Platform {
  META
  GOOGLE
  TIKTOK
  SNAPCHAT
  OTHER
}

enum Objective {
  SALES
  LEADS
  TRAFFIC
  AWARENESS
  ENGAGEMENT
}

enum CampaignStatus {
  PLANNING
  PENDING_APPROVAL
  RUNNING
  PAUSED
  COMPLETED
}

enum DeliverableType {
  DESIGN
  VIDEO
  REEL
  STORY
  COPY
  BANNER
  OTHER
}

enum DeliverableStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CHANGES_REQUESTED
  PUBLISHED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum RequestType {
  DESIGN
  VIDEO
  COPY
  CAMPAIGN
  OTHER
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  WAITING_CLIENT
  COMPLETED
  CANCELLED
}

enum AuthorType {
  CLIENT
  TEAM
}

// ─────────────────────────── Models ───────────────────────────

model Client {
  id          String       @id @default(cuid())
  name        String
  companyName String
  email       String
  phone       String?
  logo        String? // storage key of the uploaded logo (never exposed directly)
  status      ClientStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users        User[]
  campaigns    Campaign[]
  deliverables Deliverable[]
  approvals    Approval[]
  requests     Request[]
  reports      Report[]
  comments     Comment[]
  files        File[]
  assignments  ClientAssignment[]

  @@index([status])
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  clientId     String? // required for CLIENT users, null for ADMIN/TEAM
  avatar       String?
  locale       String     @default("en") // "en" | "ar"
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  client Client? @relation(fields: [clientId], references: [id])

  sessions            Session[]
  clientAssignments   ClientAssignment[]
  campaignAssignments CampaignAssignment[]
  approvals           Approval[]
  requestsCreated     Request[]            @relation("RequestCreator")
  requestsAssigned    Request[]            @relation("RequestAssignee")
  deliverablesCreated Deliverable[]        @relation("DeliverableCreator")
  comments            Comment[]
  filesUploaded       File[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([clientId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// TEAM user  <->  whole client (sees every campaign/deliverable/... of that client)
model ClientAssignment {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
}

// TEAM user  <->  a single campaign (without seeing the rest of that client)
model CampaignAssignment {
  id         String   @id @default(cuid())
  userId     String
  campaignId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@index([campaignId])
}

model Campaign {
  id                 String         @id @default(cuid())
  name               String
  clientId           String
  platform           Platform
  objective          Objective
  status             CampaignStatus @default(PLANNING)
  startDate          DateTime?
  endDate            DateTime?
  budget             Float          @default(0)
  spent              Float          @default(0)
  description        String?
  campaignExternalId String? // id of the campaign inside Meta/Google/TikTok (future integrations)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client       Client               @relation(fields: [clientId], references: [id])
  deliverables Deliverable[]
  requests     Request[]
  reports      Report[]
  files        File[]
  assignments  CampaignAssignment[]

  @@index([clientId])
  @@index([status])
}

model Deliverable {
  id          String            @id @default(cuid())
  name        String
  clientId    String
  campaignId  String?
  type        DeliverableType
  previewUrl  String?
  description String?
  status      DeliverableStatus @default(DRAFT)
  version     Int               @default(1)
  dueDate     DateTime?
  submittedAt DateTime? // set the first time the deliverable is sent to the client; clients only see submitted deliverables
  approvedAt  DateTime?
  clientComment String? // latest feedback written by the client
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  client    Client     @relation(fields: [clientId], references: [id])
  campaign  Campaign?  @relation(fields: [campaignId], references: [id])
  createdBy User?      @relation("DeliverableCreator", fields: [createdById], references: [id])
  approvals Approval[]
  comments  Comment[]
  files     File[]

  @@index([clientId, status])
  @@index([campaignId])
}

// APPEND-ONLY history. Rows are only ever inserted, never updated or deleted.
model Approval {
  id            String           @id @default(cuid())
  deliverableId String
  clientId      String
  userId        String
  decision      ApprovalDecision
  comment       String?
  version       Int
  submittedAt   DateTime?
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id])
  client      Client      @relation(fields: [clientId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@index([deliverableId, createdAt])
  @@index([clientId, decision])
}

model Request {
  id           String          @id @default(cuid())
  title        String
  clientId     String
  userId       String
  campaignId   String?
  type         RequestType
  description  String
  priority     RequestPriority @default(NORMAL)
  status       RequestStatus   @default(NEW)
  assignedToId String?
  dueDate      DateTime?
  createdAt    DateTime        @default(now())
  completedAt  DateTime?
  updatedAt    DateTime        @updatedAt

  client     Client    @relation(fields: [clientId], references: [id])
  user       User      @relation("RequestCreator", fields: [userId], references: [id])
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  assignedTo User?     @relation("RequestAssignee", fields: [assignedToId], references: [id])
  comments   Comment[]
  files      File[]

  @@index([clientId, status])
  @@index([campaignId])
}

model Report {
  id              String   @id @default(cuid())
  clientId        String
  campaignId      String
  date            DateTime
  spend           Float    @default(0)
  reach           Int      @default(0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  ctr             Float    @default(0)
  cpc             Float    @default(0)
  cpm             Float    @default(0)
  conversions     Int      @default(0)
  conversionValue Float    @default(0)
  roas            Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())

  client   Client   @relation(fields: [clientId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, date])
  @@index([clientId, date])
}

// A comment belongs to exactly one of: a deliverable OR a request.
model Comment {
  id            String     @id @default(cuid())
  deliverableId String?
  requestId     String?
  clientId      String
  userId        String
  authorType    AuthorType
  comment       String
  createdAt     DateTime   @default(now())

  deliverable Deliverable? @relation(fields: [deliverableId], references: [id])
  request     Request?     @relation(fields: [requestId], references: [id])
  client      Client       @relation(fields: [clientId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([deliverableId, createdAt])
  @@index([requestId, createdAt])
  @@index([clientId])
}

model File {
  id              String   @id @default(cuid())
  fileName        String // original (sanitised) name shown to users
  filePath        String // opaque storage key - NEVER a filesystem path, never sent to the browser
  fileType        String // MIME type
  size            Int      @default(0)
  clientId        String
  campaignId      String?
  deliverableId   String?
  requestId       String?
  version         Int      @default(1)
  visibleToClient Boolean  @default(true)
  uploadedById    String
  createdAt       DateTime @default(now())

  client      Client       @relation(fields: [clientId], references: [id])
  campaign    Campaign?    @relation(fields: [campaignId], references: [id])
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id])
  request     Request?     @relation(fields: [requestId], references: [id])
  uploadedBy  User         @relation(fields: [uploadedById], references: [id])

  @@index([clientId, createdAt])
  @@index([campaignId])
  @@index([deliverableId])
  @@index([requestId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // e.g. DELIVERABLE_SUBMITTED - translated on the frontend
  entity    String?
  entityId  String?
  data      String? // JSON with names for the translated message
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String? // JSON
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@index([userId])
}

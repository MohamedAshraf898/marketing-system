// Famolya - Prisma schema (SQLite)
// After editing this file run:  npx prisma migrate dev --name <change>

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum ClientStatus {
  LEAD
  PROSPECT
  ONBOARDING
  ACTIVE
  PAUSED
  CHURNED
  ARCHIVED
}

enum ClientType {
  BUSINESS
  STARTUP
  ENTERPRISE
  NONPROFIT
  INDIVIDUAL
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum Role {
  ADMIN
  TEAM
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Platform {
  META
  GOOGLE
  TIKTOK
  SNAPCHAT
  OTHER
}

enum Objective {
  SALES
  LEADS
  TRAFFIC
  AWARENESS
  ENGAGEMENT
}

enum CampaignStatus {
  PLANNING
  PENDING_APPROVAL
  RUNNING
  PAUSED
  COMPLETED
}

enum DeliverableType {
  DESIGN
  VIDEO
  REEL
  STORY
  COPY
  BANNER
  OTHER
}

enum DeliverableStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CHANGES_REQUESTED
  PUBLISHED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum RequestType {
  DESIGN
  VIDEO
  COPY
  CAMPAIGN
  OTHER
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  WAITING_CLIENT
  COMPLETED
  CANCELLED
}

enum AuthorType {
  CLIENT
  TEAM
}

// Shared by projects and tasks (same values as RequestPriority, kept separate on purpose).
enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  CLIENT_APPROVAL
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  BLOCKED
  DONE
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  YOUTUBE
  X
  OTHER
}

enum ContentType {
  POST
  CAROUSEL
  REEL
  STORY
  VIDEO
  ARTICLE
  AD
  OTHER
}

enum ContentStatus {
  IDEA
  DRAFT
  IN_REVIEW
  CLIENT_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ── phase 3: attendance ──

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
  DAY_OFF
  HOLIDAY
  WFH
}

enum LeaveType {
  VACATION
  SICK
  PERSONAL
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ── phase 3: task management ──

enum TaskVisibility {
  INTERNAL
  CLIENT_VISIBLE
}

enum DependencyType {
  BLOCKS
  RELATED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

enum AutomationTrigger {
  TASK_CREATED
  STATUS_CHANGED
  TASK_ASSIGNED
  TASK_OVERDUE
}

enum AutomationAction {
  NOTIFY_ASSIGNEES
  NOTIFY_REVIEWER
  NOTIFY_USER
  CREATE_TASK
  SET_PRIORITY
  ASSIGN_USER
  REQUEST_CLIENT_APPROVAL
}

// ─────────────────────────── Models ───────────────────────────

model Client {
  id          String       @id @default(cuid())
  name        String // main contact person (kept from phase 1)
  companyName String
  email       String
  phone       String?
  logo        String? // storage key of the uploaded logo (never exposed directly)
  status      ClientStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // ── CRM (phase 2) ──
  industry         String?
  website          String?
  address          String?
  country          String?
  city             String?
  leadSource       String?
  accountManagerId String?
  clientType       ClientType       @default(BUSINESS)
  tags             String? // JSON array of strings
  notes            String? // CLIENT-VISIBLE note
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  clientSince      DateTime?
  contractStart    DateTime?
  contractEnd      DateTime?
  monthlyRetainer  Float? // staff only
  internalNotes    String? // staff only - NEVER sent to CLIENT users

  accountManager User? @relation("AccountManager", fields: [accountManagerId], references: [id])

  users           User[]
  campaigns       Campaign[]
  deliverables    Deliverable[]
  approvals       Approval[]
  requests        Request[]
  reports         Report[]
  comments        Comment[]
  files           File[]
  assignments     ClientAssignment[]
  contacts        ClientContact[]
  projects        Project[]
  tasks           Task[]
  contentItems    ContentItem[]
  contracts       Contract[]
  invoices        Invoice[]
  onboardingItems OnboardingItem[]
  internalNoteRows InternalNote[]
  timeEntries     TimeEntry[]
  spaces          Space[]

  @@index([status])
  @@index([accountManagerId])
  @@index([companyName])
}

model ClientContact {
  id              String   @id @default(cuid())
  clientId        String
  name            String
  jobTitle        String?
  email           String?
  phone           String?
  whatsapp        String?
  avatar          String? // storage key (never exposed directly)
  isPrimary       Boolean  @default(false)
  visibleToClient Boolean  @default(true)
  notes           String? // internal, never sent to CLIENT users
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, isPrimary])
}

// Staff-only notes about a client (optionally about one project). CLIENT users can never read these.
model InternalNote {
  id        String   @id @default(cuid())
  clientId  String
  projectId String?
  authorId  String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  author  User     @relation("InternalNoteAuthor", fields: [authorId], references: [id])

  @@index([clientId, createdAt])
  @@index([projectId])
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  clientId     String? // required for CLIENT users, null for ADMIN/TEAM
  avatar       String?
  locale       String     @default("en") // "en" | "ar"
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // ── phase 2 ──
  jobTitle            String?
  permissions         String? // JSON array of granted permission keys (TEAM). null = role defaults. ADMIN always has all.
  weeklyCapacityHours Int     @default(40)

  // ── phase 3 ──
  workScheduleId  String? // null = the default work schedule
  trackAttendance Boolean @default(true) // appears on the attendance roster (TEAM by default; ADMIN opt-in)

  client       Client?       @relation(fields: [clientId], references: [id])
  workSchedule WorkSchedule? @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)

  sessions            Session[]
  clientAssignments   ClientAssignment[]
  campaignAssignments CampaignAssignment[]
  approvals           Approval[]
  requestsCreated     Request[]            @relation("RequestCreator")
  requestsAssigned    Request[]            @relation("RequestAssignee")
  deliverablesCreated Deliverable[]        @relation("DeliverableCreator")
  comments            Comment[]
  filesUploaded       File[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  accountManagerOf    Client[]        @relation("AccountManager")
  projectsManaged     Project[]       @relation("ProjectManager")
  projectsCreated     Project[]       @relation("ProjectCreator")
  tasksAssigned       Task[]          @relation("TaskAssignee")
  tasksCreated        Task[]          @relation("TaskCreator")
  taskComments        TaskComment[]
  contentAssigned     ContentItem[]   @relation("ContentAssignee")
  contentCreated      ContentItem[]   @relation("ContentCreator")
  onboardingAssigned  OnboardingItem[] @relation("OnboardingAssignee")
  onboardingCompleted OnboardingItem[] @relation("OnboardingCompleter")
  timeEntries         TimeEntry[]
  internalNotes       InternalNote[]  @relation("InternalNoteAuthor")
  proofingComments    ProofingComment[]
  contractsCreated    Contract[]      @relation("ContractCreator")
  invoicesCreated     Invoice[]       @relation("InvoiceCreator")

  // ── phase 3 ──
  attendances        Attendance[]     @relation("AttendanceUser")
  attendanceFixes    Attendance[]     @relation("AttendanceCorrector")
  leaveRequests      LeaveRequest[]   @relation("LeaveRequester")
  leaveReviews       LeaveRequest[]   @relation("LeaveReviewer")
  taskAssignments    TaskAssignee[]
  tasksReviewing     Task[]           @relation("TaskReviewer")

  @@index([role])
  @@index([clientId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// TEAM user  <->  whole client (sees every campaign/deliverable/... of that client)
model ClientAssignment {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
}

// TEAM user  <->  a single campaign (without seeing the rest of that client)
model CampaignAssignment {
  id         String   @id @default(cuid())
  userId     String
  campaignId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@index([campaignId])
}

model Campaign {
  id                 String         @id @default(cuid())
  name               String
  clientId           String
  platform           Platform
  objective          Objective
  status             CampaignStatus @default(PLANNING)
  startDate          DateTime?
  endDate            DateTime?
  budget             Float          @default(0)
  spent              Float          @default(0)
  description        String?
  campaignExternalId String? // id of the campaign inside Meta/Google/TikTok (future integrations)
  projectId          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client       Client               @relation(fields: [clientId], references: [id])
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks        Task[]
  contentItems ContentItem[]
  deliverables Deliverable[]
  requests     Request[]
  reports      Report[]
  files        File[]
  assignments  CampaignAssignment[]

  @@index([clientId])
  @@index([status])
  @@index([projectId])
  @@index([startDate])
  @@index([endDate])
}

model Deliverable {
  id          String            @id @default(cuid())
  name        String
  clientId    String
  campaignId  String?
  type        DeliverableType
  previewUrl  String?
  description String?
  status      DeliverableStatus @default(DRAFT)
  version     Int               @default(1)
  dueDate     DateTime?
  submittedAt DateTime? // set the first time the deliverable is sent to the client; clients only see submitted deliverables
  approvedAt  DateTime?
  clientComment String? // latest feedback written by the client
  createdById String?
  projectId   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  client    Client     @relation(fields: [clientId], references: [id])
  campaign  Campaign?  @relation(fields: [campaignId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("DeliverableCreator", fields: [createdById], references: [id])
  approvals Approval[]
  comments  Comment[]
  files     File[]
  proofing  ProofingComment[]
  contentItem ContentItem?
  tasks     Task[]

  @@index([clientId, status])
  @@index([campaignId])
  @@index([projectId])
  @@index([dueDate])
}

// APPEND-ONLY history. Rows are only ever inserted, never updated or deleted.
model Approval {
  id            String           @id @default(cuid())
  deliverableId String
  clientId      String
  userId        String
  decision      ApprovalDecision
  comment       String?
  version       Int
  submittedAt   DateTime?
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id])
  client      Client      @relation(fields: [clientId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@index([deliverableId, createdAt])
  @@index([clientId, decision])
}

model Request {
  id           String          @id @default(cuid())
  title        String
  clientId     String
  userId       String
  campaignId   String?
  type         RequestType
  description  String
  priority     RequestPriority @default(NORMAL)
  status       RequestStatus   @default(NEW)
  assignedToId String?
  dueDate      DateTime?
  createdAt    DateTime        @default(now())
  completedAt  DateTime?
  updatedAt    DateTime        @updatedAt

  client     Client    @relation(fields: [clientId], references: [id])
  user       User      @relation("RequestCreator", fields: [userId], references: [id])
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  assignedTo User?     @relation("RequestAssignee", fields: [assignedToId], references: [id])
  comments   Comment[]
  files      File[]
  tasks      Task[]

  @@index([clientId, status])
  @@index([campaignId])
}

model Report {
  id              String   @id @default(cuid())
  clientId        String
  campaignId      String
  date            DateTime
  spend           Float    @default(0)
  reach           Int      @default(0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  ctr             Float    @default(0)
  cpc             Float    @default(0)
  cpm             Float    @default(0)
  conversions     Int      @default(0)
  conversionValue Float    @default(0)
  roas            Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())

  client   Client   @relation(fields: [clientId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, date])
  @@index([clientId, date])
}

// A comment belongs to exactly one of: a deliverable OR a request.
model Comment {
  id            String     @id @default(cuid())
  deliverableId String?
  requestId     String?
  projectId     String? // project comments are shared with the client (internal talk uses TaskComment / InternalNote)
  clientId      String
  userId        String
  authorType    AuthorType
  comment       String
  createdAt     DateTime   @default(now())

  deliverable Deliverable? @relation(fields: [deliverableId], references: [id])
  request     Request?     @relation(fields: [requestId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([deliverableId, createdAt])
  @@index([requestId, createdAt])
  @@index([projectId, createdAt])
  @@index([clientId])
}

model File {
  id              String   @id @default(cuid())
  fileName        String // original (sanitised) name shown to users
  filePath        String // opaque storage key - NEVER a filesystem path, never sent to the browser
  fileType        String // MIME type
  size            Int      @default(0)
  clientId        String
  campaignId      String?
  deliverableId   String?
  requestId       String?
  projectId       String?
  contentItemId   String?
  taskId          String? // staff-only attachments
  onboardingItemId String? // staff-only
  contractId      String?
  invoiceId       String?
  version         Int      @default(1)
  visibleToClient Boolean  @default(true)
  uploadedById    String
  createdAt       DateTime @default(now())

  client      Client       @relation(fields: [clientId], references: [id])
  campaign    Campaign?    @relation(fields: [campaignId], references: [id])
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id])
  request     Request?     @relation(fields: [requestId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  onboardingItem OnboardingItem? @relation(fields: [onboardingItemId], references: [id], onDelete: SetNull)
  contract    Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  uploadedBy  User         @relation(fields: [uploadedById], references: [id])
  proofingComments ProofingComment[]

  @@index([clientId, createdAt])
  @@index([campaignId])
  @@index([deliverableId])
  @@index([requestId])
  @@index([projectId])
  @@index([contentItemId])
  @@index([taskId])
  @@index([onboardingItemId])
  @@index([contractId])
  @@index([invoiceId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // e.g. DELIVERABLE_SUBMITTED - translated on the frontend
  entity    String?
  entityId  String?
  data      String? // JSON with names for the translated message
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String? // JSON
  ip        String?
  // phase 2: the audit trail doubles as the activity feed. clientVisible rows may be shown to that client's own users.
  clientId      String?
  projectId     String?
  clientVisible Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([clientId, createdAt])
  @@index([projectId, createdAt])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@index([userId])
}

// ─────────────────────────── Phase 2: agency management ───────────────────────────

model Project {
  id              String        @id @default(cuid())
  clientId        String
  name            String
  description     String?
  status          ProjectStatus @default(PLANNING)
  priority        Priority      @default(NORMAL)
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  projectManagerId String?
  budget          Float? // staff only
  visibleToClient Boolean       @default(true) // false = internal-only project
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client         Client   @relation(fields: [clientId], references: [id])
  projectManager User?    @relation("ProjectManager", fields: [projectManagerId], references: [id])
  createdBy      User?    @relation("ProjectCreator", fields: [createdById], references: [id])
  milestones     Milestone[]
  tasks          Task[]
  campaigns      Campaign[]
  deliverables   Deliverable[]
  contentItems   ContentItem[]
  files          File[]
  comments       Comment[]
  invoices       Invoice[]
  timeEntries    TimeEntry[]
  internalNotes  InternalNote[]
  folders        Folder[]
  taskLists      TaskList[]

  @@index([clientId, status])
  @@index([status, dueDate])
  @@index([projectManagerId])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
}

// Tasks are INTERNAL agency work by default. A CLIENT user only ever sees tasks of their own company that were explicitly
// marked CLIENT_VISIBLE, and only through the client-facing API (routes/clientTasks.ts) with a stripped-down shape.
model Task {
  id             String     @id @default(cuid())
  projectId      String?
  clientId       String?
  campaignId     String?
  title          String
  description    String?
  assignedToId   String? // primary assignee (kept for compatibility); every assignee also has a TaskAssignee row
  createdById    String?
  priority       Priority   @default(NORMAL)
  status         TaskStatus @default(TODO) // the status CATEGORY - custom statuses map onto one of these
  dueDate        DateTime?
  completedAt    DateTime?
  estimatedHours Float?
  actualHours    Float      @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // ── phase 3: hierarchy, planning, links ──
  listId              String?
  parentId            String?
  depth               Int            @default(0) // 0 = top-level task, 1 = subtask, ...
  position            Float          @default(0) // manual order inside a list / board column / parent
  startDate           DateTime?
  visibility          TaskVisibility @default(INTERNAL)
  reviewerId          String?
  deliverableId       String?
  requestId           String?
  customStatusId      String?
  blockOnDependencies Boolean        @default(false) // true: cannot start until every blocking task is completed
  archivedAt          DateTime?
  recurrenceSourceId  String? // set on tasks generated by a recurrence
  occurrenceDate      DateTime? // the occurrence (date-only) this generated task stands for

  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client       Client?           @relation(fields: [clientId], references: [id])
  campaign     Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assignedTo   User?             @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy    User?             @relation("TaskCreator", fields: [createdById], references: [id])
  reviewer     User?             @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  list         TaskList?         @relation(fields: [listId], references: [id], onDelete: SetNull)
  parent       Task?             @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]            @relation("Subtasks")
  deliverable  Deliverable?      @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  request      Request?          @relation(fields: [requestId], references: [id], onDelete: SetNull)
  customStatus TaskStatusOption? @relation(fields: [customStatusId], references: [id], onDelete: SetNull)
  recurrenceSource Task?         @relation("RecurrenceInstances", fields: [recurrenceSourceId], references: [id], onDelete: SetNull)
  recurrenceInstances Task[]     @relation("RecurrenceInstances")
  checklist    TaskChecklistItem[]
  comments     TaskComment[]
  files        File[]
  timeEntries  TimeEntry[]
  assignees    TaskAssignee[]
  tagLinks     TaskTagLink[]
  fieldValues  TaskCustomFieldValue[]
  dependencies TaskDependency[]  @relation("DependencyTask")
  dependents   TaskDependency[]  @relation("DependencyOn")
  recurrence   TaskRecurrence?

  @@unique([recurrenceSourceId, occurrenceDate]) // a recurrence can never generate the same occurrence twice
  @@index([assignedToId, status])
  @@index([clientId, status])
  @@index([projectId, status])
  @@index([campaignId])
  @@index([dueDate])
  @@index([status, dueDate])
  @@index([listId, status, position])
  @@index([parentId, position])
  @@index([startDate])
  @@index([archivedAt])
  @@index([clientId, visibility])
  @@index([deliverableId])
  @@index([requestId])
  @@index([reviewerId])
}

model TaskChecklistItem {
  id          String    @id @default(cuid())
  taskId      String
  text        String
  done        Boolean   @default(false)
  position    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

// Discussion on a task. Staff comments are internal unless explicitly shared (clientVisible) on a CLIENT_VISIBLE task;
// comments written by a client are always clientVisible. CLIENT users never receive an internal comment.
model TaskComment {
  id            String     @id @default(cuid())
  taskId        String
  userId        String
  comment       String
  createdAt     DateTime   @default(now())
  // ── phase 3 ──
  editedAt      DateTime?
  authorType    AuthorType @default(TEAM)
  clientVisible Boolean    @default(false)
  mentions      String? // JSON array of mentioned user ids (validated server-side)
  attachmentIds String? // JSON array of File ids attached to this task (validated server-side)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId, createdAt])
  @@index([taskId, clientVisible])
}

// ─────────────────────────── Phase 3: task hierarchy (Workspace = the agency itself) ───────────────────────────

// Top-level container. A space may belong to one client (then only staff with access to that client see it).
model Space {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String    @default("#6366f1")
  clientId    String?
  position    Int       @default(0)
  archivedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client       Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  folders      Folder[]
  lists        TaskList[]
  statuses     TaskStatusOption[]
  customFields TaskCustomField[]

  @@index([position])
  @@index([clientId])
}

model Folder {
  id         String    @id @default(cuid())
  spaceId    String
  name       String
  projectId  String? // optional link to an agency project
  position   Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  space   Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  project Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lists   TaskList[]

  @@index([spaceId, position])
  @@index([projectId])
}

// A list lives directly in a space or inside a folder. Linked to a project, its new tasks inherit that project + client.
model TaskList {
  id          String    @id @default(cuid())
  spaceId     String
  folderId    String?
  projectId   String?
  name        String
  description String?
  color       String?
  position    Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  space   Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  folder  Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([spaceId, folderId, position])
  @@index([projectId])
}

// Custom status of a space. `category` is the built-in status it behaves as (dashboards, progress, overdue ...).
model TaskStatusOption {
  id        String     @id @default(cuid())
  spaceId   String
  name      String
  color     String     @default("#71717a")
  category  TaskStatus
  position  Int        @default(0)
  createdAt DateTime   @default(now())

  space Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([spaceId, position])
}

model TaskAssignee {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#71717a")
  createdAt DateTime @default(now())

  links TaskTagLink[]
}

model TaskTagLink {
  id     String @id @default(cuid())
  taskId String
  tagId  String

  task Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  TaskTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([tagId])
}

// Field definition. spaceId = null -> available in every space.
model TaskCustomField {
  id        String          @id @default(cuid())
  spaceId   String?
  name      String
  type      CustomFieldType
  options   String? // JSON array of strings (SELECT)
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  space  Space?                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  values TaskCustomFieldValue[]

  @@index([spaceId, position])
}

model TaskCustomFieldValue {
  id        String   @id @default(cuid())
  taskId    String
  fieldId   String
  value     String // normalised text form (number, yyyy-mm-dd, "true"/"false", option)
  updatedAt DateTime @updatedAt

  task  Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field TaskCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([taskId, fieldId])
  @@index([fieldId])
}

// BLOCKS: `dependsOn` blocks `task` (task is "blocked by" dependsOn).  RELATED: plain two-way link (stored once).
model TaskDependency {
  id          String         @id @default(cuid())
  taskId      String
  dependsOnId String
  type        DependencyType @default(BLOCKS)
  createdById String?
  createdAt   DateTime       @default(now())

  task      Task @relation("DependencyTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependencyOn", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

// Reusable blueprint: one parent task + its subtasks (items).
model TaskTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?
  taskTitle       String
  taskDescription String?
  priority        Priority @default(NORMAL)
  estimatedHours  Float?
  checklist       String? // JSON array of strings
  tags            String? // JSON array of tag names
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items TaskTemplateItem[]

  @@index([name])
}

model TaskTemplateItem {
  id             String  @id @default(cuid())
  templateId     String
  title          String
  description    String?
  position       Int     @default(0)
  estimatedHours Float?
  dueOffsetDays  Int? // due date = start of the generated task + N days

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position])
}

// The task it hangs off is the blueprint; each occurrence becomes a new Task (recurrenceSourceId + occurrenceDate unique).
model TaskRecurrence {
  id        String              @id @default(cuid())
  taskId    String              @unique
  frequency RecurrenceFrequency
  interval  Int                 @default(1) // every N days / weeks / months
  weekdays  String? // WEEKLY: "1,4" (0 = Sunday)
  monthDay  Int? // MONTHLY: 1..31 (clamped to the month length)
  nextDate  DateTime // date-only: next occurrence to generate
  endDate   DateTime?
  active    Boolean             @default(true)
  lastRunAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([active, nextDate])
}

// Simple internal "when X then Y" rules. Scoped to a space or list (both null = everywhere).
model TaskAutomation {
  id            String            @id @default(cuid())
  name          String
  enabled       Boolean           @default(true)
  spaceId       String?
  listId        String?
  trigger       AutomationTrigger
  triggerStatus TaskStatus? // STATUS_CHANGED: only when the task moves INTO this status (null = any change)
  action        AutomationAction
  config        String? // JSON, depends on the action
  runCount      Int               @default(0)
  lastRunAt     DateTime?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([enabled, trigger])
}

// ─────────────────────────── Phase 3: attendance ───────────────────────────

model WorkSchedule {
  id             String   @id @default(cuid())
  name           String
  timezone       String   @default("UTC") // IANA zone the times below are in
  workDays       String   @default("1,2,3,4,5") // 0 = Sunday ... 6 = Saturday
  startTime      String   @default("09:00")
  endTime        String   @default("17:00")
  breakMinutes   Int      @default(60) // unpaid break included in the day
  graceMinutes   Int      @default(10) // check-in within start + grace is on time
  minimumMinutes Int      @default(240) // worked less than this on a checked-out day -> HALF_DAY
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users       User[]
  attendances Attendance[]
}

// One row per person per (schedule-local) day. Timestamps are ALWAYS set by the server.
model Attendance {
  id                String           @id @default(cuid())
  userId            String
  date              DateTime // date-only (UTC midnight) of the local work day
  scheduleId        String?
  checkInAt         DateTime?
  checkOutAt        DateTime?
  remote            Boolean          @default(false)
  status            AttendanceStatus
  statusLocked      Boolean          @default(false) // an administrator set the status by hand
  breakMinutes      Int              @default(0)
  workedMinutes     Int              @default(0)
  expectedMinutes   Int              @default(0)
  lateMinutes       Int              @default(0)
  earlyLeaveMinutes Int              @default(0)
  overtimeMinutes   Int              @default(0)
  notes             String?
  isManual          Boolean          @default(false) // corrected / created by an administrator
  correctedById     String?
  correctedAt       DateTime?
  leaveRequestId    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user         User              @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  schedule     WorkSchedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  correctedBy  User?             @relation("AttendanceCorrector", fields: [correctedById], references: [id], onDelete: SetNull)
  leaveRequest LeaveRequest?     @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  breaks       AttendanceBreak[]

  @@unique([userId, date])
  @@index([date, status])
  @@index([leaveRequestId])
}

model AttendanceBreak {
  id           String    @id @default(cuid())
  attendanceId String
  startAt      DateTime
  endAt        DateTime?
  createdAt    DateTime  @default(now())

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId, startAt])
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique // date-only
  name      String
  createdAt DateTime @default(now())
}

model LeaveRequest {
  id              String      @id @default(cuid())
  userId          String
  type            LeaveType
  startDate       DateTime // date-only, inclusive
  endDate         DateTime // date-only, inclusive
  days            Int         @default(0) // working days covered (by the person's schedule)
  reason          String?
  status          LeaveStatus @default(PENDING)
  reviewedById    String? // who approved / rejected
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user        User         @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy  User?        @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  attendances Attendance[]

  @@index([userId, startDate])
  @@index([status, startDate])
}

// Content calendar entry. Client approval is NOT a second system: when sent for approval the item gets a linked
// Deliverable and the normal (append-only) approval workflow runs on that deliverable.
model ContentItem {
  id            String         @id @default(cuid())
  clientId      String
  campaignId    String?
  projectId     String?
  title         String
  platform      SocialPlatform @default(INSTAGRAM)
  contentType   ContentType    @default(POST)
  caption       String?
  status        ContentStatus  @default(IDEA)
  publishDate   DateTime?
  assignedToId  String?
  deliverableId String?        @unique
  notes         String? // internal notes, staff only
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  client      Client       @relation(fields: [clientId], references: [id])
  campaign    Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo  User?        @relation("ContentAssignee", fields: [assignedToId], references: [id])
  createdBy   User?        @relation("ContentCreator", fields: [createdById], references: [id])
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  files       File[]

  @@index([clientId, publishDate])
  @@index([status, publishDate])
  @@index([campaignId])
  @@index([projectId])
  @@index([assignedToId])
}

// Pin (x,y as fractions 0..1 of the image) or video timestamp comment on a deliverable file.
model ProofingComment {
  id            String     @id @default(cuid())
  deliverableId String
  fileId        String?
  version       Int
  x             Float? // 0..1 from the left of the image
  y             Float? // 0..1 from the top of the image
  timestampSec  Float? // video comments (seconds)
  comment       String
  userId        String
  authorType    AuthorType
  resolved      Boolean    @default(false)
  resolvedAt    DateTime?
  resolvedById  String?
  createdAt     DateTime   @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  file        File?       @relation(fields: [fileId], references: [id], onDelete: SetNull)
  user        User        @relation(fields: [userId], references: [id])

  @@index([deliverableId, createdAt])
  @@index([fileId])
}

model OnboardingItem {
  id            String    @id @default(cuid())
  clientId      String
  title         String
  description   String?
  position      Int       @default(0)
  done          Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  assignedToId  String?
  dueDate       DateTime?
  notes         String? // internal
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedTo  User?  @relation("OnboardingAssignee", fields: [assignedToId], references: [id])
  completedBy User?  @relation("OnboardingCompleter", fields: [completedById], references: [id])
  files       File[]

  @@index([clientId, position])
  @@index([assignedToId])
}

model Contract {
  id              String         @id @default(cuid())
  clientId        String
  name            String
  contractNumber  String         @unique
  startDate       DateTime?
  endDate         DateTime?
  renewalDate     DateTime?
  value           Float          @default(0)
  status          ContractStatus @default(DRAFT)
  notes           String? // internal
  visibleToClient Boolean        @default(false)
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client    Client @relation(fields: [clientId], references: [id])
  createdBy User?  @relation("ContractCreator", fields: [createdById], references: [id])
  files     File[]

  @@index([clientId, status])
  @@index([status, endDate])
  @@index([renewalDate])
}

// Internal agency invoicing only. No payments, no subscriptions.
model Invoice {
  id              String        @id @default(cuid())
  clientId        String
  projectId       String?
  invoiceNumber   String        @unique
  issueDate       DateTime
  dueDate         DateTime
  amount          Float // subtotal
  tax             Float         @default(0) // tax amount
  total           Float // always amount + tax, computed by the server
  status          InvoiceStatus @default(DRAFT)
  description     String?
  notes           String? // internal
  paidAt          DateTime?
  visibleToClient Boolean       @default(false)
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client    Client   @relation(fields: [clientId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("InvoiceCreator", fields: [createdById], references: [id])
  files     File[]

  @@index([clientId, status])
  @@index([status, dueDate])
}

model TimeEntry {
  id          String    @id @default(cuid())
  userId      String
  taskId      String?
  projectId   String?
  clientId    String?
  startedAt   DateTime
  endedAt     DateTime? // null = timer still running
  durationSec Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id])
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([userId, endedAt])
  @@index([clientId, startedAt])
  @@index([projectId])
  @@index([taskId])
}

// Single row (id = "singleton"): agency name, colours, logo and favicon.
model AppSettings {
  id             String   @id @default("singleton")
  agencyName     String   @default("Famolya")
  primaryColor   String   @default("#4f46e5")
  secondaryColor String   @default("#0f172a")
  logoKey        String?
  faviconKey     String?
  updatedAt      DateTime @updatedAt
}
